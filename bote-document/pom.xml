    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>bote-document</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.iwhalecloud.bote</groupId>
      <artifactId>bote-base</artifactId>
    </dependency>
    <dependency>
      <groupId>com.iwhalecloud.bote</groupId>
      <artifactId>bote-llm-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <dependency>
      <groupId>com.iwhalecloud.bss.litchi</groupId>
      <artifactId>litchi-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.iwhalecloud.bss.litchi</groupId>
      <artifactId>litchi-job</artifactId>
    </dependency>

    <!-- 鉴权模块 -->
    <dependency>
      <groupId>com.iwhalecloud.bss.litchi</groupId>
      <artifactId>litchi-security</artifactId>
    </dependency>

    <!-- 数据库驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
