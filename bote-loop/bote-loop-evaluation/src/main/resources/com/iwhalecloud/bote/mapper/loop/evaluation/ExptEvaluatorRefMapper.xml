<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwhalecloud.bote.mapper.loop.evaluation.ExptEvaluatorRefMapper">
  <!-- 结果映射 -->
  <resultMap id="BaseResultMap" type="com.iwhalecloud.bote.entity.loop.evaluation.ExptEvaluatorRefEntity">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="space_id" property="spaceId" jdbcType="BIGINT"/>
    <result column="expt_id" property="exptId" jdbcType="BIGINT"/>
    <result column="evaluator_id" property="evaluatorId" jdbcType="BIGINT"/>
    <result column="evaluator_version_id" property="evaluatorVersionId" jdbcType="BIGINT"/>
    <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    <result column="deleted_at" property="deletedAt" jdbcType="BIGINT"/>
  </resultMap>

  <!-- 基础字段列表 -->
  <sql id="Base_Column_List">
    id, space_id, expt_id, evaluator_id, evaluator_version_id,
    created_at, updated_at, deleted_at
  </sql>

  <!-- 创建实验评估器引用 -->
  <insert id="create">
    INSERT INTO bt_expt_evaluator_ref (
    id, space_id, expt_id, evaluator_id, evaluator_version_id,
    created_at, updated_at, deleted_at
    ) VALUES
    <foreach collection="exptEvaluatorRefs" item="item" separator=",">
      (
      #{item.id}, #{item.spaceId}, #{item.exptId}, #{item.evaluatorId}, #{item.evaluatorVersionId},
      #{item.createdAt}, #{item.updatedAt}, #{item.deletedAt}
      )
    </foreach>
  </insert>

  <!-- 批量根据实验ID获取评估器引用 -->
  <select id="mGetByExptId" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM bt_expt_evaluator_ref
    WHERE space_id = #{spaceId}
    AND expt_id IN
    <foreach collection="exptIds" item="exptId" open="(" separator="," close=")">
      #{exptId}
    </foreach>
  </select>
</mapper>
