<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.iwhalecloud.bote.mapper.loop.data.tag.TagKeyMapper">
  <!-- 结果映射 -->
  <resultMap id="BaseResultMap" type="com.iwhalecloud.bote.entity.loop.data.tag.TagKeyEntity">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="app_id" property="appId" jdbcType="INTEGER"/>
    <result column="space_id" property="spaceId" jdbcType="BIGINT"/>
    <result column="version" property="version" jdbcType="VARCHAR"/>
    <result column="version_num" property="versionNum" jdbcType="INTEGER"/>
    <result column="tag_key_id" property="tagKeyId" jdbcType="BIGINT"/>
    <result column="tag_key_name" property="tagKeyName" jdbcType="VARCHAR"/>
    <result column="description" property="description" jdbcType="VARCHAR"/>
    <result column="status" property="status" jdbcType="VARCHAR"/>
    <result column="tag_type" property="tagType" jdbcType="VARCHAR"/>
    <result column="tag_target_type" property="tagTargetType" jdbcType="VARCHAR"/>
    <result column="parent_key_id" property="parentKeyId" jdbcType="BIGINT"/>
    <result column="change_log" property="changeLog" jdbcType="LONGVARCHAR"/>
    <result column="created_by" property="createdBy" jdbcType="VARCHAR"/>
    <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    <result column="updated_by" property="updatedBy" jdbcType="VARCHAR"/>
    <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    <result column="content_type" property="contentType" jdbcType="VARCHAR"/>
    <result column="spec" property="spec" jdbcType="LONGVARCHAR"/>
  </resultMap>

  <!-- 基础字段 -->
  <sql id="Base_Column_List">
    id
    , app_id, space_id, version, version_num, tag_key_id, tag_key_name,
        description, status, tag_type, tag_target_type, parent_key_id, change_log,
        created_by, created_at, updated_by, updated_at, content_type, spec
  </sql>

  <!-- 根据spaceId和id查询 -->
  <select id="selectBySpaceIdAndId" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM tag_key
    WHERE space_id = #{spaceId} AND id = #{id}
  </select>

  <!-- 根据条件查询 -->
  <select id="selectByCondition" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM tag_key
    <where>
      <if test="spaceId != null">
        AND space_id = #{spaceId}
      </if>
      <if test="ids != null and ids.size() > 0">
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
          #{id}
        </foreach>
      </if>
      <if test="tagType != null">
        AND tag_type = #{tagType}
      </if>
      <if test="statusList != null and statusList.size() > 0">
        AND status IN
        <foreach collection="statusList" item="status" open="(" separator="," close=")">
          #{status}
        </foreach>
      </if>
      <if test="tagKeyIds != null and tagKeyIds.size() > 0">
        AND tag_key_id IN
        <foreach collection="tagKeyIds" item="tagKeyId" open="(" separator="," close=")">
          #{tagKeyId}
        </foreach>
      </if>
      <if test="createdBys != null and createdBys.size() > 0">
        AND created_by IN
        <foreach collection="createdBys" item="createdBy" open="(" separator="," close=")">
          #{createdBy}
        </foreach>
      </if>
      <if test="contentTypes != null and contentTypes.size() > 0">
        AND content_type IN
        <foreach collection="contentTypes" item="contentType" open="(" separator="," close=")">
          #{contentType}
        </foreach>
      </if>
      <if test="tagKeyName != null">
        AND tag_key_name = #{tagKeyName}
      </if>
      <if test="tagKeyNameLike != null">
        AND tag_key_name LIKE #{tagKeyNameLike}
      </if>
    </where>
    ORDER BY id DESC
  </select>

  <!-- 根据条件统计数量 -->
  <select id="countByCondition" resultType="java.lang.Long">
    SELECT COUNT(1)
    FROM tag_key
    <where>
      <if test="spaceId != null">
        AND space_id = #{spaceId}
      </if>
      <if test="ids != null and ids.size() > 0">
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
          #{id}
        </foreach>
      </if>
      <if test="tagType != null">
        AND tag_type = #{tagType}
      </if>
      <if test="statusList != null and statusList.size() > 0">
        AND status IN
        <foreach collection="statusList" item="status" open="(" separator="," close=")">
          #{status}
        </foreach>
      </if>
      <if test="tagKeyIds != null and tagKeyIds.size() > 0">
        AND tag_key_id IN
        <foreach collection="tagKeyIds" item="tagKeyId" open="(" separator="," close=")">
          #{tagKeyId}
        </foreach>
      </if>
      <if test="createdBys != null and createdBys.size() > 0">
        AND created_by IN
        <foreach collection="createdBys" item="createdBy" open="(" separator="," close=")">
          #{createdBy}
        </foreach>
      </if>
      <if test="contentTypes != null and contentTypes.size() > 0">
        AND content_type IN
        <foreach collection="contentTypes" item="contentType" open="(" separator="," close=")">
          #{contentType}
        </foreach>
      </if>
      <if test="tagKeyName != null">
        AND tag_key_name = #{tagKeyName}
      </if>
      <if test="tagKeyNameLike != null">
        AND tag_key_name LIKE #{tagKeyNameLike}
      </if>
    </where>
  </select>

  <!-- 批量插入 -->
  <insert id="batchInsert" parameterType="java.util.List">
    INSERT INTO tag_key (
    id, app_id, space_id, version, version_num, tag_key_id, tag_key_name,
    description, status, tag_type, tag_target_type, parent_key_id, change_log,
    created_by, created_at, updated_by, updated_at, content_type, spec
    ) VALUES
    <foreach collection="list" item="item" separator=",">
      (
      #{item.id}, #{item.appId}, #{item.spaceId}, #{item.version}, #{item.versionNum},
      #{item.tagKeyId}, #{item.tagKeyName}, #{item.description}, #{item.status},
      #{item.tagType}, #{item.tagTargetType}, #{item.parentKeyId}, #{item.changeLog},
      #{item.createdBy}, #{item.createdAt}, #{item.updatedBy}, #{item.updatedAt},
      #{item.contentType}, #{item.spec}
      )
    </foreach>
  </insert>

  <!-- 根据条件更新 - 使用PO层对象，所有判断在XML中处理 -->
  <update id="updateByCondition">
    UPDATE tag_key
    <set>
      <if test="updateEntity.tagKeyName != null and updateEntity.tagKeyName != ''">
        tag_key_name = #{updateEntity.tagKeyName},
      </if>
      <if test="updateEntity.description != null">
        description = #{updateEntity.description},
      </if>
      <if test="updateEntity.status != null and updateEntity.status != ''">
        status = #{updateEntity.status},
      </if>
      <if test="updateEntity.tagType != null and updateEntity.tagType != ''">
        tag_type = #{updateEntity.tagType},
      </if>
      <if test="updateEntity.contentType != null and updateEntity.contentType != ''">
        content_type = #{updateEntity.contentType},
      </if>
      <if test="updateEntity.updatedBy != null and updateEntity.updatedBy != ''">
        updated_by = #{updateEntity.updatedBy},
      </if>
      <if test="updateEntity.updatedAt != null">
        updated_at = #{updateEntity.updatedAt},
      </if>
      <if test="updateEntity.version != null">
        version = #{updateEntity.version},
      </if>
      <if test="updateEntity.versionNum != null">
        version_num = #{updateEntity.versionNum},
      </if>
      <if test="updateEntity.tagKeyId != null">
        tag_key_id = #{updateEntity.tagKeyId},
      </if>
      <if test="updateEntity.tagTargetType != null">
        tag_target_type = #{updateEntity.tagTargetType},
      </if>
      <if test="updateEntity.parentKeyId != null">
        parent_key_id = #{updateEntity.parentKeyId},
      </if>
      <if test="updateEntity.changeLog != null">
        change_log = #{updateEntity.changeLog},
      </if>
      <if test="updateEntity.spec != null">
        spec = #{updateEntity.spec},
      </if>
    </set>
    WHERE space_id = #{spaceId} AND id = #{id}
  </update>

  <!-- 更新状态 -->
  <update id="updateStatusByCondition">
    UPDATE tag_key
    <set>
      status = #{status}
      <if test="updatedAt != null and updatedAt != ''">
        , updated_at = #{updatedAt}
      </if>
      <if test="updatedBy != null and updatedBy != ''">
        , updated_by = #{updatedBy}
      </if>
    </set>
    WHERE space_id = #{spaceId} AND tag_key_id = #{tagKeyId} AND version_num = #{versionNum}
  </update>

  <!-- 根据spaceId和id删除 -->
  <delete id="deleteBySpaceIdAndId">
    DELETE
    FROM tag_key
    WHERE space_id = #{spaceId}
      AND id = #{id}
  </delete>
</mapper>
