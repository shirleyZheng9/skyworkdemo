<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iwhalecloud.bote.mapper.loop.data.dataset.SchemaMapper">
  <!-- 结果映射 -->
  <resultMap id="SchemaResultMap" type="com.iwhalecloud.bote.entity.loop.data.dataset.DatasetSchemaEntity">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="app_id" property="appId" jdbcType="INTEGER"/>
    <result column="space_id" property="spaceId" jdbcType="BIGINT"/>
    <result column="dataset_id" property="datasetId" jdbcType="BIGINT"/>
    <result column="fields" property="fields" jdbcType="VARCHAR"/>
    <result column="immutable" property="immutable" jdbcType="CHAR"/>
    <result column="created_by" property="createdBy" jdbcType="VARCHAR"/>
    <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    <result column="updated_by" property="updatedBy" jdbcType="VARCHAR"/>
    <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    <result column="update_version" property="updateVersion" jdbcType="BIGINT"/>
  </resultMap>

  <!-- 基础字段 -->
  <sql id="Base_Column_List">
    id
    , app_id, space_id, dataset_id, fields, immutable, created_by, created_at,
        updated_by, updated_at, update_version
  </sql>

  <!-- 创建Schema -->
  <insert id="createSchema" parameterType="com.iwhalecloud.bote.entity.loop.data.dataset.DatasetSchemaEntity">
    INSERT INTO bt_dataset_schema (id, app_id, space_id, dataset_id, fields, immutable, created_by, created_at,
                                   updated_by, updated_at, update_version)
    VALUES (#{id}, #{appId}, #{spaceId}, #{datasetId}, #{fields}, #{immutable}, #{createdBy}, #{createdAt},
            #{updatedBy}, #{updatedAt}, #{updateVersion})
  </insert>

  <!-- 更新Schema -->
  <update id="updateSchema">
    UPDATE bt_dataset_schema
    <set>
      <if test="schema.appId != null">
        app_id = #{schema.appId},
      </if>
      <if test="schema.datasetId != null">
        dataset_id = #{schema.datasetId},
      </if>
      <if test="schema.fields != null">
        fields = #{schema.fields},
      </if>
      <if test="schema.immutable != null">
        immutable = #{schema.immutable},
      </if>
      <if test="schema.updatedBy != null">
        updated_by = #{schema.updatedBy},
      </if>
      <if test="schema.updatedAt != null">
        updated_at = #{schema.updatedAt},
      </if>
      <if test="schema.updateVersion != null">
        update_version = #{schema.updateVersion},
      </if>
    </set>
    WHERE space_id = #{schema.spaceId} AND id = #{schema.id}
  </update>

  <!-- 获取Schema -->
  <select id="getSchema" resultMap="SchemaResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM bt_dataset_schema
    WHERE space_id = #{spaceId} AND id = #{id}
  </select>

  <!-- 批量获取Schema -->
  <select id="mGetSchema" resultMap="SchemaResultMap">
    SELECT
    <include refid="Base_Column_List"/>
    FROM bt_dataset_schema
    WHERE space_id = #{spaceId}
    AND id IN
    <foreach collection="ids" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
  </select>
</mapper>
